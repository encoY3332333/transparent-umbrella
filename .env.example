# ===============================================================
# SmartTrip 环境变量样例
# ===============================================================
# 使用方法：
#   cp .env.example backend/.env
#   然后按实际情况修改 backend/.env（.env 已被 .gitignore 忽略，不会入库）
#
# 默认值即可直接启动：DATABASE_URL 指向 SQLite，第三方服务全部为占位符，
# 未填写的服务会在启动时降级（见 docs/architecture.md 6.2）。
#
# ⚠️ 严禁把真实密钥写进本文件后提交。
# ===============================================================

# ---------------------------- 应用 ----------------------------
APP_NAME=smart-trip
APP_ENV=dev
APP_PORT=8000
# 会话与签名的密钥。生产环境必须替换为随机长串（python -c "import secrets;print(secrets.token_urlsafe(48))"）
SECRET_KEY=change_me_in_local_env
# 访问日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# ---------------------------- 数据库 --------------------------
# 开发默认 SQLite；切 MySQL 时改为 mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4
# 测试用 sqlite+pysqlite:///:memory:
DATABASE_URL=sqlite+pysqlite:///./smarttrip.db
# 连接池大小（SQLite 上无效，MySQL 生效）
DB_POOL_SIZE=10
DB_POOL_RECYCLE_SECONDS=1800

# ---------------------------- 认证 ----------------------------
# JWT 签名密钥，与 SECRET_KEY 分开更安全
JWT_SECRET=change_me_in_local_env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 验证码错误容忍次数与锁定窗口（分钟）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# ---------------------------- 缓存 ----------------------------
# 第三方查询结果缓存有效期（秒），不得大于 86400
CACHE_TTL_SECONDS=3600
# 策略参数的进程内缓存（秒）
STRATEGY_CACHE_TTL_SECONDS=60

# ---------------------------- 第三方服务 ----------------------
# 天气服务（OpenWeather One Call API 3.0）
WEATHER_BASE_URL=https://api.openweathermap.org/data/3.0
WEATHER_API_KEY=your_weather_api_key_here

# 地理编码与路径规划（高德开放平台 Web 服务 API）
MAP_BASE_URL=https://restapi.amap.com/v3
MAP_API_KEY=your_map_api_key_here

# 景区人流量数据系统（课程模拟服务）
TRAFFIC_BASE_URL=https://traffic.example.edu/api
TRAFFIC_API_KEY=your_traffic_api_key_here

# 交通票务查询系统（课程模拟服务）
TRANSIT_BASE_URL=https://transit.example.edu/api
TRANSIT_API_KEY=your_transit_api_key_here

# 活动与节庆日历系统（课程模拟服务）
EVENT_BASE_URL=https://event.example.edu/api
EVENT_API_KEY=your_event_api_key_here

# 住宿库存与报价系统（课程模拟服务）
HOTEL_BASE_URL=https://hotel.example.edu/api
HOTEL_API_KEY=your_hotel_api_key_here

# 统一身份认证系统（课程模拟服务）
AUTH_BASE_URL=https://auth.example.edu/api
AUTH_CLIENT_ID=your_client_id
AUTH_CLIENT_SECRET=your_client_secret

# ---------------------------- 外部调用约束 --------------------
# 单次规划允许的最大外部接口调用次数（BR-10）
PLAN_EXTERNAL_CALL_LIMIT=60
# 单个外部接口超时（秒，httpx 用 float）
EXTERNAL_CONNECT_TIMEOUT=1.5
EXTERNAL_READ_TIMEOUT=3.0
# 单个接口最大重试次数
EXTERNAL_MAX_RETRIES=2

# ---------------------------- 排程引擎 ------------------------
# 五项权重之和必须为 1（BR-23）。这里的值仅作为首次初始化写入数据库，
# 运行期以数据库中的 strategy_parameter 为准（F9 可调）。
STRATEGY_W_PREF=0.10
STRATEGY_W_WEATHER=0.25
STRATEGY_W_CROWD=0.23
STRATEGY_W_TRAVEL=0.14
STRATEGY_W_COST=0.28
# 排程最大迭代次数（预算降本迭代）
STRATEGY_MAX_ITERATION=30
# 单日游玩时长上限（小时）
STRATEGY_DAILY_HOURS=10

# ---------------------------- 管理后台 ------------------------
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change_me_in_local_env

# ---------------------------- 分享服务 ------------------------
# 分享链接有效期（天），BR 约束：7 天
SHARE_LINK_TTL_DAYS=7
# 分享链接签名盐值（生产环境必须替换为随机长串）
SHARE_SIGN_SALT=change_me_in_local_env
